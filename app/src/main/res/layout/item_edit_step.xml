<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="8dp"
    android:gravity="center_vertical">

    <!-- Иконка перетаскивания (гамбургер) -->
    <ImageView
        android:id="@+id/ivDragHandle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_menu"
        android:layout_marginEnd="12dp"
        app:tint="@color/dark_text_secondary" />

    <!-- Номер шага (можно оставить) -->
    <TextView
        android:id="@+id/tvStepNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/card_background"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginEnd="12dp"
        android:textColor="@color/neon_green"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- Текст шага -->
    <EditText
        android:id="@+id/etStepDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:background="@android:color/transparent"
        android:hint="Введите шаг"
        android:textColorHint="@color/dark_text_secondary"
        android:singleLine="false"
        android:inputType="textMultiLine"
        android:layout_marginEnd="8dp" />

    <!-- Иконка удаления -->
    <LinearLayout
        android:id="@+id/ivDeleteStep"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:padding="10dp"
        android:orientation="vertical"
        android:background="@drawable/button_background"
        android:gravity="center">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/neon_green" />
    </LinearLayout>

</LinearLayout>
