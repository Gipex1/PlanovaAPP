<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1817">

    <!-- Гайдлайн для верхнего отступа (15% от высоты) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.13" />

    <!-- LOGO привязан к гайдлайну сверху -->
    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:src="@drawable/ic_logo3"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="@id/guideline_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/neon_green"/>

    <!-- TITLE -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Подтверждение входа"
        android:textSize="25sp"
        android:textColor="#E6E6E6"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/iv_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- SUBTITLE -->
    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="342dp"
        android:layout_height="70dp"
        android:layout_marginTop="8dp"
        android:text="Мы отправили код подтверждения на email example@mail.com"
        android:textAlignment="center"
        android:textColor="#8A8F8D"
        android:textSize="17sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title" />

    <!-- Контейнер OTP (привязан к низу SUBTITLE и верху кнопки, будет по центру) -->
    <LinearLayout
        android:id="@+id/otp_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="50dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <EditText android:id="@+id/et_code_1" style="@style/OtpBox"/>
        <EditText android:id="@+id/et_code_2" style="@style/OtpBox"/>
        <EditText android:id="@+id/et_code_3" style="@style/OtpBox"/>
        <EditText android:id="@+id/et_code_4" style="@style/OtpBox"/>
        <EditText android:id="@+id/et_code_5" style="@style/OtpBox"/>
    </LinearLayout>

    <!-- TIMER TEXT (привязан к OTP и кнопке) -->
    <TextView
        android:id="@+id/tv_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Код отправлен повторно через 00:45"
        android:textColor="#8A8F8D"
        android:textSize="20sp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/otp_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- BUTTON -->
    <Button
        android:id="@+id/btn_confirm"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="Подтвердить"
        android:textSize="25sp"
        android:textColor="#0F1817"
        android:backgroundTint="#00FF9C"
        android:layout_marginHorizontal="40dp"
        android:layout_marginBottom="50dp"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toTopOf="@id/tv_resend"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>

    <!-- RESEND (привязан к bottom с отступом) -->
    <TextView
        android:id="@+id/tv_resend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Не получили код?"
        android:textColor="#6F7F7A"
        android:textSize="20sp"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>