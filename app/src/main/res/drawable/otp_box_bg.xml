<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ФОКУС (когда нажали на поле) -->
    <item android:state_focused="true">
        <shape>
            <solid android:color="#0A100F"/>
            <corners android:radius="14dp"/>
            <stroke
                android:width="2dp"
                android:color="#00FF9C"/>
        </shape>
    </item>

    <!-- Обычное состояние -->
    <item>
        <shape>
            <solid android:color="#0A100F"/>
            <corners android:radius="14dp"/>
            <stroke
                android:width="1dp"
                android:color="#1A2A27"/>
        </shape>
    </item>

</selector>