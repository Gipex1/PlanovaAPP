<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Фокус - Тёмная тема -->
    <item android:state_focused="true" android:state_checked="false">
        <shape>
            <solid android:color="@color/dark_surface"/>
            <corners android:radius="14dp"/>
            <stroke
                android:width="2dp"
                android:color="@color/neon_green"/>
        </shape>
    </item>

    <!-- Фокус - Светлая тема -->
    <item android:state_focused="true" android:state_checked="true">
        <shape>
            <solid android:color="@color/light_surface"/>
            <corners android:radius="14dp"/>
            <stroke
                android:width="2dp"
                android:color="@color/neon_green_dark"/>
        </shape>
    </item>

    <!-- Обычное состояние - Тёмная тема -->
    <item android:state_checked="false">
        <shape>
            <solid android:color="@color/dark_surface"/>
            <corners android:radius="14dp"/>
            <stroke
                android:width="1dp"
                android:color="@color/dark_border"/>
        </shape>
    </item>

    <!-- Обычное состояние - Светлая тема -->
    <item android:state_checked="true">
        <shape>
            <solid android:color="@color/light_surface"/>
            <corners android:radius="14dp"/>
            <stroke
                android:width="1dp"
                android:color="@color/light_border"/>
        </shape>
    </item>

</selector>