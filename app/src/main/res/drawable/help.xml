<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Тёмная тема -->
    <item android:state_checked="false">
        <shape>
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="@color/dark_background"
                android:endColor="@color/dark_surface"/>
        </shape>
    </item>

    <!-- Светлая тема -->
    <item android:state_checked="true">
        <shape>
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="@color/light_background"
                android:endColor="@color/light_surface"/>
        </shape>
    </item>

</selector>