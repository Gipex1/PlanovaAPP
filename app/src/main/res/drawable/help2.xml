<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Тёмная тема -->
    <item android:state_checked="false">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="100dp"
                android:centerColor="#66A6FF00"
                android:endColor="#00A6FF00"
                android:centerX="0.5"
                android:centerY="0.5"/>
        </shape>
    </item>

    <!-- Светлая тема -->
    <item android:state_checked="true">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="100dp"
                android:centerColor="#33A6FF00"
                android:endColor="#00A6FF00"
                android:centerX="0.5"
                android:centerY="0.5"/>
        </shape>
    </item>

</selector>