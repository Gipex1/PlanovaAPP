<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== СВЕТЛАЯ ТЕМА ===== -->
    <style name="Base.Theme.Planova" parent="Theme.Material3.Light.NoActionBar">
        <!-- PRIMARY -->
        <item name="colorPrimary">@color/neon_green</item>
        <item name="colorPrimaryVariant">@color/neon_green_dark</item>
        <item name="colorSecondary">@color/neon_green</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- BACKGROUND -->
        <item name="android:windowBackground">@color/light_background</item>
        <item name="colorSurface">@color/light_surface</item>
        <item name="colorOnSurface">@color/light_text_primary</item>

        <!-- STATUS BAR -->
        <item name="android:statusBarColor">@color/light_background</item>
        <item name="android:navigationBarColor">@color/light_background</item>

        <!-- TEXT -->
        <item name="android:textColorPrimary">@color/light_text_primary</item>
        <item name="android:textColorSecondary">@color/light_text_secondary</item>

        <!-- CARDS -->
        <item name="cardBackgroundColor">@color/light_card</item>
        <item name="cardElevation">4dp</item>
    </style>

    <style name="Theme.Planova" parent="Base.Theme.Planova" />

</resources>